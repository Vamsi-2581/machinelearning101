# Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# Analytics Configuration (Optional)
# ============================================
# Plausible Analytics - Privacy-focused analytics
# Get your domain from https://plausible.io after creating an account
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Optional: Use a self-hosted Plausible instance
# NUXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# ============================================
# Authentication Backend (Optional)
# ============================================
# API URL for Cloudflare Worker authentication backend
# Leave empty or comment out to run without authentication
# 
# For local development (with worker running locally):
# NUXT_PUBLIC_API_URL=http://localhost:8787
#
# For production (after deploying worker):
# NUXT_PUBLIC_API_URL=https://your-worker.your-subdomain.workers.dev
#
# Note: The platform works fully without authentication.
# Authentication is only needed for:
# - Syncing progress across devices
# - Persistent user accounts
# - Cloud backup of learning progress
NUXT_PUBLIC_API_URL=http://localhost:8787
