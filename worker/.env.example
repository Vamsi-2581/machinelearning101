# Cloudflare Worker Environment Variables
# 
# IMPORTANT: These values should be set as Cloudflare Worker secrets
# using the Wrangler CLI, NOT stored in a .env file in production.
#
# This file is for reference only. To set secrets:
#   wrangler secret put SECRET_NAME
#
# For local development, you can create a .dev.vars file (gitignored)
# with these values for use with `wrangler dev`.

# ============================================
# Google OAuth Configuration
# ============================================
# Get these from: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URI

# Your Google OAuth client ID
GOOGLE_CLIENT_ID=1091671952478-qkihi9sq3hbvbc1veqqog3afte4ljhhq.apps.googleusercontent.com

# Your Google OAuth client secret
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth callback URL (must match Google Console configuration)
# For local development: http://localhost:8787/api/auth/google/callback
# For production: https://api.machinelearningsimplified.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/auth/google/callback

# ============================================
# JWT Configuration
# ============================================
# Secret key for signing JWT tokens
# Generate a secure random key with: openssl rand -base64 32
# IMPORTANT: Keep this secret and never commit it to version control
JWT_SECRET=iyZtsfz4e0hG2q7WjymYQpH+k79WLRtotF1AmbAphdc=

# ============================================
# CORS Configuration..
# ============================================
# Frontend URL for CORS headers
# For local development: http://localhost:3000
# For production: https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ============================================
# Setup Instructions
# ============================================
# 
# 1. Set secrets for production:
#    wrangler secret put GOOGLE_CLIENT_ID
#    wrangler secret put GOOGLE_CLIENT_SECRET
#    wrangler secret put GOOGLE_REDIRECT_URI
#    wrangler secret put JWT_SECRET
#    wrangler secret put FRONTEND_URL
#
# 2. For local development, create .dev.vars file:
#    cp .env.example .dev.vars
#    # Edit .dev.vars with your actual values
#    # .dev.vars is gitignored and safe for local secrets
#
# 3. Database setup:
#    wrangler d1 create ml-platform-db
#    # Update wrangler.toml with database ID
#    ./migrate.sh prod
#
# See README.md and SETUP.md for detailed instructions.
