{
  "id": "gradient-descent",
  "name": "Gradient Descent Optimization",
  "domain": "optimization",
  "difficulty": "intermediate",
  "estimatedTime": 6,
  "prerequisites": [
    "linear-regression"
  ],
  "learningObjectives": [
    "Understand how gradient descent minimizes loss functions",
    "Compare different optimizer variants (SGD, Momentum, RMSProp, Adam)",
    "Learn the impact of learning rate on convergence",
    "Visualize optimization paths on different loss landscapes",
    "Recognize challenges like local minima and saddle points"
  ],
  "interactive": {
    "algorithm": "GradientDescentVisualization",
    "defaultParams": {
      "lossFunction": "quadratic-bowl",
      "optimizer": "sgd",
      "learningRate": 0.1,
      "momentum": 0.9,
      "beta": 0.9,
      "beta1": 0.9,
      "beta2": 0.999,
      "startX": -3,
      "startY": 2
    },
    "controls": [
      {
        "id": "lossFunction",
        "type": "select",
        "label": "Loss Function",
        "options": [
          "quadratic-bowl",
          "elongated-valley",
          "rosenbrock",
          "beale",
          "himmelblau",
          "saddle-point",
          "rastrigin"
        ],
        "tooltip": "Choose a loss landscape to optimize"
      },
      {
        "id": "optimizer",
        "type": "select",
        "label": "Optimizer",
        "options": [
          "sgd",
          "momentum",
          "rmsprop",
          "adam"
        ],
        "tooltip": "Choose an optimization algorithm"
      },
      {
        "id": "learningRate",
        "type": "slider",
        "label": "Learning Rate",
        "min": 0.001,
        "max": 1,
        "step": 0.001,
        "tooltip": "Controls step size in parameter space"
      }
    ],
    "visualizations": [
      {
        "type": "contour",
        "title": "Loss Landscape (Contour)"
      },
      {
        "type": "surface",
        "title": "Loss Landscape (3D Surface)"
      },
      {
        "type": "line",
        "title": "Loss Over Iterations"
      }
    ]
  }
}
