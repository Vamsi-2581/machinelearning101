{
  "id": "optimizer-comparison",
  "name": "Optimizer Comparison",
  "domain": "optimization",
  "difficulty": "advanced",
  "estimatedTime": 35,
  "prerequisites": ["gradient-descent"],
  "learningObjectives": [
    "Understand different optimization algorithms (SGD, Momentum, RMSProp, Adam)",
    "Learn how momentum accelerates convergence",
    "Explore adaptive learning rate methods",
    "Compare optimizer performance on different loss landscapes",
    "Recognize when to use each optimizer"
  ],
  "keywords": [
    "optimization",
    "SGD",
    "momentum",
    "RMSProp",
    "Adam",
    "adaptive learning rate",
    "gradient descent",
    "convergence",
    "learning rate",
    "optimizer comparison"
  ],
  "interactive": {
    "algorithm": "OptimizerComparison",
    "defaultParams": {
      "optimizer": "adam",
      "learningRate": 0.01,
      "momentum": 0.9,
      "beta1": 0.9,
      "beta2": 0.999,
      "lossFunction": "rosenbrock"
    },
    "controls": [
      {
        "id": "lossFunction",
        "type": "select",
        "label": "Loss Function",
        "group": "Problem",
        "tooltip": "Choose a loss landscape to optimize",
        "options": [
          {
            "label": "Rosenbrock (Narrow valley)",
            "value": "rosenbrock"
          },
          {
            "label": "Beale (Multiple local minima)",
            "value": "beale"
          },
          {
            "label": "Sphere (Simple convex)",
            "value": "sphere"
          },
          {
            "label": "Rastrigin (Many local minima)",
            "value": "rastrigin"
          }
        ]
      },
      {
        "id": "optimizer",
        "type": "select",
        "label": "Optimizer",
        "group": "Algorithm",
        "tooltip": "Choose optimization algorithm",
        "options": [
          {
            "label": "SGD (Stochastic Gradient Descent)",
            "value": "sgd"
          },
          {
            "label": "SGD with Momentum",
            "value": "momentum"
          },
          {
            "label": "RMSProp",
            "value": "rmsprop"
          },
          {
            "label": "Adam",
            "value": "adam"
          },
          {
            "label": "AdaGrad",
            "value": "adagrad"
          }
        ]
      },
      {
        "id": "learningRate",
        "type": "slider",
        "label": "Learning Rate",
        "group": "Hyperparameters",
        "min": 0.001,
        "max": 0.1,
        "step": 0.001,
        "tooltip": "Step size for parameter updates"
      },
      {
        "id": "momentum",
        "type": "slider",
        "label": "Momentum (for Momentum/Adam)",
        "group": "Hyperparameters",
        "min": 0,
        "max": 0.99,
        "step": 0.01,
        "tooltip": "Momentum coefficient (0 = no momentum, 0.9 = typical)"
      },
      {
        "id": "beta1",
        "type": "slider",
        "label": "Beta1 (for Adam)",
        "group": "Hyperparameters",
        "min": 0.8,
        "max": 0.999,
        "step": 0.001,
        "tooltip": "Exponential decay rate for first moment (typically 0.9)"
      },
      {
        "id": "beta2",
        "type": "slider",
        "label": "Beta2 (for Adam)",
        "group": "Hyperparameters",
        "min": 0.9,
        "max": 0.9999,
        "step": 0.0001,
        "tooltip": "Exponential decay rate for second moment (typically 0.999)"
      }
    ],
    "datasets": []
  },
  "visualizations": [
    {
      "type": "contour",
      "title": "Loss Landscape & Optimization Path",
      "description": "Contour plot showing loss landscape and optimizer trajectory"
    },
    {
      "type": "line",
      "title": "Loss vs. Iteration",
      "description": "Line chart showing how loss decreases over iterations"
    },
    {
      "type": "line",
      "title": "Learning Rate Schedule",
      "description": "Line chart showing effective learning rate over time"
    }
  ],
  "metrics": [
    {
      "id": "finalLoss",
      "name": "Final Loss",
      "description": "Loss value at the end of optimization"
    },
    {
      "id": "iterations",
      "name": "Iterations to Converge",
      "description": "Number of iterations to reach near-optimal solution"
    },
    {
      "id": "avgStepSize",
      "name": "Average Step Size",
      "description": "Average magnitude of parameter updates"
    }
  ]
}
